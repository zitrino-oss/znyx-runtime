FROM python:3.14-slim

WORKDIR /app

RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*

# Install the engine + inference sidecar with the serving stack ([onnx]) and the export
# stack ([export]) so the console's Install button can download + ONNX-export models.
# CPU-only torch is installed first from the PyTorch CPU index (~200 MB instead of ~2.5 GB
# with CUDA) — the export pipeline never uses GPU.
COPY packages/znyx-core /app/packages/znyx-core
COPY packages/znyx-inference /app/packages/znyx-inference
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu && \
    pip install --no-cache-dir ./packages/znyx-core "./packages/znyx-inference[onnx,export]"

# Non-root. /models is the read-only mount point for fetched, sha256-pinned weights.
RUN useradd -m -u 1000 appuser && \
    mkdir -p /models /app/.cache/znyx && \
    chown -R appuser:appuser /models /app/.cache
USER appuser

ENV PORT=9000
EXPOSE 9000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:9000/healthz')"

CMD ["python", "-m", "uvicorn", "znyx_inference.main:app", "--host", "0.0.0.0", "--port", "9000"]
