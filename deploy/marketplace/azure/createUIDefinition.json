{
  "$schema": "https://schema.management.azure.com/schemas/0.1.2-preview/CreateUIDefinition.MultiVm.json#",
  "handler": "Microsoft.Azure.CreateUIDef",
  "version": "0.1.2-preview",
  "parameters": {
    "config": {"basics": {"location": {"visible": false}, "resourceGroup": {"allowExisting": true}}},
    "basics": [
      {
        "name": "clusterLookup",
        "type": "Microsoft.Solutions.ArmApiControl",
        "request": {"method": "GET", "path": "[concat(subscription().id, '/resourceGroups/', resourceGroup().name, '/providers/Microsoft.ContainerService/managedClusters?api-version=2024-10-01')]"}
      },
      {
        "name": "clusterResourceId", "type": "Microsoft.Common.DropDown", "label": "Existing AKS cluster",
        "toolTip": "Select the prepared customer cluster. No cluster or operator access is created by this offer.",
        "constraints": {"required": true, "allowedValues": "[map(basics('clusterLookup').value, (item) => parse(concat('{\"label\":\"', item.name, '\",\"value\":\"', item.id, '\"}')))]"}
      },
      {
        "name": "extensionResourceName", "type": "Microsoft.Common.TextBox", "label": "Extension name", "defaultValue": "znyxruntime",
        "constraints": {"required": true, "regex": "^[a-z0-9]{6,30}$", "validationMessage": "Use 6 to 30 lowercase letters and digits."}
      }
    ],
    "steps": [{
      "name": "runtime", "label": "Customer runtime", "elements": [
        {"name": "prerequisites", "type": "Microsoft.Common.InfoBox", "visible": true, "options": {"icon": "Info", "text": "Prepare the znyx namespace, a customer-managed Secret, private TLS Redis, and the read-only model PVC before installing. Credentials stay in the Secret. Use a Linux AMD64 media image. Follow the operated Azure runbook for access and audit configuration."}},
        {"name": "controlPlaneUrl", "type": "Microsoft.Common.TextBox", "label": "Control plane HTTPS URL", "constraints": {"required": true, "regex": "^https://[^\\s?#@]+$", "validationMessage": "Enter the approved HTTPS control plane URL without credentials, query or fragment."}},
        {"name": "existingSecret", "type": "Microsoft.Common.TextBox", "label": "Existing Secret name", "defaultValue": "znyx-runtime-secrets", "constraints": {"required": true, "regex": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$", "validationMessage": "Enter the existing Kubernetes Secret name."}},
        {"name": "dataClaim", "type": "Microsoft.Common.TextBox", "label": "Existing shared runtime data PVC", "defaultValue": "znyx-data", "constraints": {"required": true, "regex": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$", "validationMessage": "Enter the existing ReadWriteMany data PVC name."}},
        {"name": "redisPrivateIp", "type": "Microsoft.Common.TextBox", "label": "Redis private endpoint IPv4", "toolTip": "Only this IPv4 /32 and the selected TLS port are added to egress. The Secret contains the rediss:// DNS endpoint and credentials.", "constraints": {"required": true, "regex": "^(10\\.([0-9]{1,3}\\.){2}[0-9]{1,3}|172\\.(1[6-9]|2[0-9]|3[0-1])\\.[0-9]{1,3}\\.[0-9]{1,3}|192\\.168\\.[0-9]{1,3}\\.[0-9]{1,3})$", "validationMessage": "Enter the customer private Redis endpoint IPv4."}},
        {"name": "redisPort", "type": "Microsoft.Common.TextBox", "label": "Redis TLS port", "defaultValue": "10000", "constraints": {"required": true, "regex": "^[0-9]{1,5}$", "validationMessage": "Enter the TLS port, between 1 and 65535."}},
        {"name": "mediaEnabled", "type": "Microsoft.Common.CheckBox", "label": "Enable offline OCR and speech inspection", "defaultValue": true},
        {"name": "modelClaim", "type": "Microsoft.Common.TextBox", "label": "Existing read-only model PVC", "defaultValue": "znyx-models", "constraints": {"required": true, "regex": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$", "validationMessage": "Enter the existing model PVC name."}}
      ]
    }],
    "outputs": {
      "clusterResourceId": "[basics('clusterResourceId')]",
      "extensionResourceName": "[basics('extensionResourceName')]",
      "controlPlaneUrl": "[steps('runtime').controlPlaneUrl]",
      "existingSecret": "[steps('runtime').existingSecret]",
      "dataClaim": "[steps('runtime').dataClaim]",
      "redisPrivateIp": "[steps('runtime').redisPrivateIp]",
      "redisPort": "[int(steps('runtime').redisPort)]",
      "mediaEnabled": "[steps('runtime').mediaEnabled]",
      "modelClaim": "[steps('runtime').modelClaim]"
    }
  }
}
